  "grammar": [
    {
      "form": "普通形[ふつうけい] · Short (Plain) Forms",
      "tag": "The casual counterpart to ます／です",
      "def": [
        "Short (plain) forms are the casual counterpart to the long (polite) forms used so far. Verbs: dictionary form / ない-form. い-adjectives: drop です from both forms, so 高[たか]いです→高[たか]い and 高[たか]くないです→高[たか]くない. な-adjectives and noun+です: replace です with だ (affirmative) or drop です (negative, ～じゃない)."
      ],
      "ex": [
        "食[た]べます→食[た]べる、食[た]べません→食[た]べない。",
        "高[たか]いです→高[たか]い、高[たか]くないです→高[たか]くない。",
        "静[しず]かです→静[しず]かだ、静[しず]かじゃないです→静[しず]かじゃない。"
      ],
      "table": {
        "head": [
          "Type",
          "Long form",
          "Short form"
        ],
        "rows": [
          [
            "Verb (aff.)",
            "食[た]べます",
            "食[た]べる"
          ],
          [
            "Verb (neg.)",
            "食[た]べません",
            "食[た]べない"
          ],
          [
            "い-adj (aff.)",
            "高[たか]いです",
            "高[たか]い"
          ],
          [
            "い-adj (neg.)",
            "高[たか]くないです",
            "高[たか]くない"
          ],
          [
            "な-adj/Noun (aff.)",
            "静[しず]かです",
            "静[しず]かだ"
          ],
          [
            "な-adj/Noun (neg.)",
            "静[しず]かじゃないです",
            "静[しず]かじゃない"
          ]
        ]
      },
      "ruleTable": "nai"
    },
    {
      "form": "普通形[ふつうけい]とくだけた会話[かいわ] · Short Forms in Informal Speech",
      "tag": "Casual conversation rules",
      "def": [
        "Close friends and family use short forms at the end of sentences. Casual questions drop か and rely on rising intonation; だ after な-adjectives/nouns is usually dropped too, but kept before ね or よ."
      ],
      "ex": [
        "今日[きょう]、暇[ひま]？ (Are you free today?)",
        "メアリーさんは二年生[にねんせい]だよ。 (Mary is a sophomore.)"
      ]
    },
    {
      "form": "普通形[ふつうけい]＋と思[おも]います",
      "tag": "Stating an opinion in quoted-speech form",
      "def": [
        "Attach と思[おも]います to a short-form clause to state an opinion, \"I think that ~.\" To say you don't think something is so, it's more natural to make the clause itself negative: ～ないと思[おも]います."
      ],
      "ex": [
        "たけしさんはメアリーさんが好[す]きだと思[おも]います。 (I think Takeshi likes Mary.)"
      ]
    },
    {
      "form": "普通形[ふつうけい]＋と言[い]っていました",
      "tag": "Reporting what someone else said",
      "def": [
        "Attach と言[い]っていました to a short-form clause to report what someone said, \"they said that ~.\" The tense of the original statement is preserved."
      ],
      "ex": [
        "山下[やました]先生[せんせい]は結婚[けっこん]していないと言[い]っていました。 (Professor Yamashita said he isn't married.)"
      ]
    },
    {
      "form": "～ないでください",
      "tag": "A softer negative request",
      "def": [
        "Attach でください to a verb's short negative (ない) form for a softer request not to do something than てはいけません."
      ],
      "ex": [
        "ここで写真[しゃしん]を撮[と]らないでください。 (Please don't take pictures here.)"
      ]
    },
    {
      "form": "動詞[どうし]＋のが好[す]きです／上手[じょうず]です",
      "tag": "Nominalizing a verb with の",
      "def": [
        "Adding の after a verb's short form turns it into a noun, so it can pair with 好[す]き／嫌[きら]い／上手[じょうず]／下手[へた]."
      ],
      "ex": [
        "ロバートさんは料理[りょうり]を作[つく]るのが上手[じょうず]です。 (Robert is good at cooking.)"
      ]
    },
    {
      "form": "主語[しゅご]を表[あらわ]す が · The Subject Particle が",
      "tag": "New information vs. known topic (は)",
      "def": [
        "が marks a subject that is new information to the listener, unlike は which marks an already-known topic. Question words like だれ and 何[なに] as the subject always take が, never は."
      ],
      "ex": [
        "だれが沖縄[おきなわ]に行[い]きましたか。 (Who went to Okinawa?)"
      ]
    },
    {
      "form": "何[なに]か／何[なに]も",
      "tag": "\"something\" vs. \"nothing\" (+ negative)",
      "def": [
        "何[なに]か means \"something\" (positive statements/questions); 何[なに]も with a negative verb means \"not...anything.\""
      ],
      "ex": [
        "猫[ねこ]が何[なに]か持[も]ってきました。 (The cat brought something.)",
        "猫[ねこ]は何[なに]も食[た]べませんでした。 (The cat didn't eat anything.)"
      ]
    }
  ]
}

  "grammar": [
    {
      "form": "Xが あります／います",
      "tag": "Existence — non-living vs. living things",
      "def": [
        "Say something exists with [place]に[thing]があります (non-living things) or [place]に[person]がいます (people, animals). あります can also mean \"to have\" or that an event will take place."
      ],
      "ex": [
        "部屋にテレビがありません。 (I don't have a TV in my room.)",
        "あそこに猫がいます。 (There's a cat over there.)"
      ],
      "table": {
        "head": [
          "Type",
          "Verb"
        ],
        "rows": [
          [
            "Non-living",
            "あります"
          ],
          [
            "Living (people/animals)",
            "います"
          ]
        ]
      }
    },
    {
      "form": "Xは Yの[位置]です · Describing Where Things Are",
      "tag": "Precise spatial location",
      "def": [
        "Add a position word after の to say where something is relative to another place or object. Pattern: XはYの[position]です。"
      ],
      "ex": [
        "銀行は図書館の隣です。 (The bank is next to the library.)",
        "傘はテーブルの下です。 (The umbrella is under the table.)"
      ],
      "table": {
        "head": [
          "Word",
          "Meaning"
        ],
        "rows": [
          [
            "右／左",
            "right / left"
          ],
          [
            "前／後ろ",
            "front / behind"
          ],
          [
            "中／上／下",
            "inside / on / under"
          ],
          [
            "近く／隣／間",
            "near / next to / between"
          ]
        ]
      }
    },
    {
      "form": "です の過去形 · Past Tense of です",
      "tag": "でした／じゃなかったです",
      "def": [
        "Affirmative past: です → でした. Negative past: じゃないです → じゃなかったです."
      ],
      "ex": [
        "昨日は雨でした。 (It was rainy yesterday.)",
        "あれは日本の映画じゃなかったです。 (That wasn't a Japanese movie.)"
      ]
    },
    {
      "form": "動詞の過去形 · Past Tense of Verbs",
      "tag": "ました／ませんでした",
      "def": [
        "Affirmative past: ます → ました. Negative past: ません → ませんでした."
      ],
      "ex": [
        "メアリーさんは九時ごろうちに帰りました。 (Mary went home around nine.)",
        "私は昨日日本語を勉強しませんでした。 (I didn't study Japanese yesterday.)"
      ],
      "table": {
        "head": [
          "",
          "Present",
          "Past"
        ],
        "rows": [
          [
            "Affirmative",
            "～ます",
            "～ました"
          ],
          [
            "Negative",
            "～ません",
            "～ませんでした"
          ]
        ]
      }
    },
    {
      "form": "も (review)",
      "tag": "\"also/too\" attaching to any particle",
      "def": [
        "も means \"also/too.\" It replaces は, が, or を; with other particles like に or で, it follows them (にも, でも)."
      ],
      "ex": [
        "私は先週京都に行きました。大阪にも行きました。 (I went to Kyoto last week. I went to Osaka too.)"
      ]
    },
    {
      "form": "一時間 · Duration",
      "tag": "Bare-noun durations + ぐらい／半",
      "def": [
        "Duration is expressed with a bare noun like 一時間 — no particle attaches to it. Add ぐらい for \"about,\" and 半 for \"and a half\" (半 comes before ぐらい)."
      ],
      "ex": [
        "昨日日本語を三時間ぐらい勉強しました。 (I studied Japanese for about three hours yesterday.)"
      ]
    },
    {
      "form": "たくさん · Quantity Words",
      "tag": "Can go before the noun or after its particle",
      "def": [
        "A quantity word like たくさん can go either before the noun or right after its particle (を or が)."
      ],
      "ex": [
        "京都で写真をたくさん撮りました。 (I took a lot of pictures in Kyoto.)"
      ]
    },
    {
      "form": "と",
      "tag": "\"and\" (nouns) / \"with\" (companion)",
      "def": [
        "と connects two nouns (\"A and B\") or marks who you did something with (\"together with\")."
      ],
      "ex": [
        "日本語と英語を話します。 (I speak Japanese and English.)",
        "メアリーさんはソラさんと韓国に行きます。 (Mary will go to Korea with Sora.)"
      ]
    }
  ]
}

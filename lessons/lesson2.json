  "grammar": [
    {
      "form": "これ／それ／あれ／どれ",
      "tag": "\"this / that / that over there / which\" (standalone)",
      "def": [
        "これ refers to something close to the speaker, それ to something close to the listener, and あれ to something far from both. どれ asks \"which one\" among three or more options. These re-series words stand alone as noun phrases and are best avoided when referring to people."
      ],
      "ex": [
        "これは いくらですか。 (How much is this?)",
        "それは 三千円です。 (That is 3,000 yen.)"
      ],
      "table": {
        "head": [
          "Word",
          "Refers to"
        ],
        "rows": [
          [
            "これ",
            "close to speaker"
          ],
          [
            "それ",
            "close to listener"
          ],
          [
            "あれ",
            "far from both"
          ],
          [
            "どれ",
            "which (3+ options)"
          ]
        ]
      }
    },
    {
      "form": "この／その／あの／どの + Noun",
      "tag": "\"this / that / that / which\" + noun",
      "def": [
        "Unlike the re-series, the no-series must be followed directly by a noun. They follow the same distance logic as これ/それ/あれ/どれ and, unlike them, are fine to use when referring to people."
      ],
      "ex": [
        "この時計は いくらですか。 (How much is this watch?)",
        "あの学生は 留学生です。 (That student over there is an international student.)"
      ],
      "table": {
        "head": [
          "re-series",
          "no-series",
          "Refers to"
        ],
        "rows": [
          [
            "これ（は～）",
            "この noun（は～）",
            "close to speaker"
          ],
          [
            "それ（は～）",
            "その noun（は～）",
            "close to listener"
          ],
          [
            "あれ（は～）",
            "あの noun（は～）",
            "far from both"
          ],
          [
            "どれ（が～）",
            "どの noun（が～）",
            "unknown"
          ]
        ]
      }
    },
    {
      "form": "ここ／そこ／あそこ／どこ",
      "tag": "\"here / there / over there / where\"",
      "def": [
        "The last ko-so-a-do set covers locations: ここ (here, near me), そこ (there, near you), あそこ (over there), and どこ (where)."
      ],
      "ex": [
        "すみません。郵便局は どこですか。 (Excuse me, where is the post office?)",
        "（郵便局は）あそこです。 (It's right over there.)"
      ]
    },
    {
      "form": "だれの Noun",
      "tag": "\"whose ~\" — asking who something belongs to",
      "def": [
        "だれ is \"who\"; adding the particle の makes it \"whose.\" This builds on the Noun1のNoun2 possessive pattern from Lesson 1."
      ],
      "ex": [
        "これは だれの かばんですか。 (Whose bag is this?)",
        "それは ソラさんの かばんです。 (That is Sora's bag.)"
      ]
    },
    {
      "form": "Noun も",
      "tag": "\"~, too\" — attaches directly to the shared noun",
      "def": [
        "も means \"also/too.\" Unlike English, where \"too\" can trail the whole sentence, も must attach directly after the noun that shares the property just mentioned."
      ],
      "ex": [
        "たけしさんは 日本人です。 (Takeshi is Japanese.)",
        "ゆいさんも 日本人です。 (Yui is Japanese, too.)"
      ],
      "table": {
        "head": [
          "",
          "Pattern",
          "Meaning"
        ],
        "rows": [
          [
            "A",
            "はXです",
            "A is X"
          ],
          [
            "B",
            "もXです",
            "B too is X"
          ]
        ]
      }
    },
    {
      "form": "Noun じゃないです",
      "tag": "Negating X wa Y desu sentences",
      "def": [
        "To negate です after a noun, replace it with じゃないです. じゃありません is a more conservative variant, and ではありません is the most formal, written-appropriate form. です/じゃない never stand alone — they always need a noun."
      ],
      "ex": [
        "山田さんは 学生じゃないです。 (Mr. Yamada is not a student.)",
        "いいえ、日本人じゃないです。 (No, I am not Japanese.)"
      ],
      "table": {
        "head": [
          "Style",
          "Form"
        ],
        "rows": [
          [
            "Affirmative",
            "（Xは）Yです"
          ],
          [
            "Negative (casual)",
            "（Xは）Yじゃないです"
          ],
          [
            "Negative (neutral)",
            "（Xは）Yじゃありません"
          ],
          [
            "Negative (formal)",
            "（Xは）Yではありません"
          ]
        ]
      }
    },
    {
      "form": "～ね／～よ",
      "tag": "Confirmation vs. assertion tags",
      "def": [
        "Add ね when you want the listener's agreement or confirmation (\"right?\"). Add よ when you're confident about what you're saying and want to make sure the listener knows it."
      ],
      "ex": [
        "リーさんの専攻は 文学ですね。 (Ms. Lee, your major is literature, right?)",
        "とんかつは 魚じゃないですよ。 (Let me assure you, tonkatsu isn't fish.)"
      ]
    }
  ]

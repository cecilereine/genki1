  "kanji": [],
  "grammar": [
    {
      "form": "Xは Yです",
      "tag": "\"X is Y\" — basic identity statements",
      "def": [
        "です simply means \"is.\" Japanese sentences often drop the subject entirely when it's clear from context. When you do need to state a topic, mark it with は (pronounced \"wa\" in this role)."
      ],
      "ex": [
        "がくせいです。 (I am a student.)",
        "わたしはソラ・キムです。 (I am Sora Kim.)"
      ]
    },
    {
      "form": "～か",
      "tag": "Turning a statement into a question",
      "def": [
        "Add か to the end of a statement to turn it into a question — word order doesn't change, and no question mark is used. Question words include なん／なに (what), なんじ (what time), なんさい (how old), なんねんせい (what year in school), なんばん (what number)."
      ],
      "ex": [
        "りゅうがくせいですか。 (Are you an international student?)",
        "いま、なんじですか。 (What time is it now?)"
      ]
    },
    {
      "form": "Noun1の Noun2",
      "tag": "Connecting two nouns — possession & specification",
      "def": [
        "の connects two nouns: the second noun is the main idea, and the first noun restricts or specifies it — similar to the possessive \"'s\" in English, but more general."
      ],
      "ex": [
        "たけしさんのでんわばんごう (Takeshi's phone number)",
        "にほんのだいがく (a university in Japan)"
      ]
    }
  ]
}

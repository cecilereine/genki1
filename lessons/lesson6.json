  "grammar": [
    {
      "form": "動詞のて形 · The Te-form of Verbs",
      "tag": "Formation rules for all three verb groups",
      "def": [
        "る-verbs: drop る, add て. う-verbs follow sound-based rules depending on the final syllable. Irregulars: する→して, 来る→来て."
      ],
      "ex": [],
      "table": {
        "head": [
          "Ending",
          "Rule",
          "Example"
        ],
        "rows": [
          [
            "る-verb",
            "drop る + て",
            "食べる→食べて"
          ],
          [
            "う・つ・る",
            "→って",
            "買う→買って"
          ],
          [
            "む・ぶ・ぬ",
            "→んで",
            "読む→読んで"
          ],
          [
            "く",
            "→いて (exception 行く→行って)",
            "書く→書いて"
          ],
          [
            "ぐ",
            "→いで",
            "泳ぐ→泳いで"
          ],
          [
            "す",
            "→して",
            "話す→話して"
          ],
          [
            "irregular",
            "special",
            "する→して／来る→来て"
          ]
        ]
      }
    },
    {
      "form": "て形＋ください",
      "tag": "Polite requests — \"please do ~\"",
      "def": [
        "\"Please do ~.\" Attach ください directly after the て-form."
      ],
      "ex": [
        "ここに名前を書いてください。 (Please write your name here.)"
      ]
    },
    {
      "form": "二つの動作を表す · Describing Two Activities",
      "tag": "て-form joins clauses like \"and\"",
      "def": [
        "The て-form links two or more verbs the way \"and\" does in English, describing a sequence, manner, or reason. The final verb's tense applies to the whole sentence."
      ],
      "ex": [
        "図書館に行って、本を借ります。 (I will go to the library and check out some books.)",
        "バスに乗って、会社に行きます。 (I go to work by bus.)"
      ]
    },
    {
      "form": "て形＋もいいです",
      "tag": "Asking/giving permission",
      "def": [
        "\"You may ~\" / \"May I ~?\" — a very common way to ask if something is allowed."
      ],
      "ex": [
        "トイレに行ってもいいですか。 (May I go to the bathroom?)"
      ]
    },
    {
      "form": "て形＋はいけません",
      "tag": "Prohibition — \"must not ~\"",
      "def": [
        "\"You must not ~,\" a strong prohibition often used for rules."
      ],
      "ex": [
        "ここで写真を撮ってはいけません。 (You must not take pictures here.)"
      ]
    },
    {
      "form": "～から",
      "tag": "Giving a reason",
      "def": [
        "から attaches to the end of the clause that explains the reason, before the main clause or as a stand-alone justification."
      ],
      "ex": [
        "バスに乗りましょう。タクシーは高いですから。 (Let's go by bus. Taxis are expensive.)"
      ]
    },
    {
      "form": "～ましょうか (申し出) · Offering Assistance",
      "tag": "\"Shall I ~?\" — offering to help",
      "def": [
        "Beyond proposing to do something together (Lesson 5), ましょうか can also mean \"let me do it,\" offering to help someone."
      ],
      "ex": [
        "荷物を持ちましょうか。 (Shall I carry your luggage?)"
      ]
    }
  ]
}

  "grammar": [
    {
      "form": "～ている（動作の進行）",
      "tag": "\"is doing ~\" / habitual occupation",
      "def": [
        "Activity verbs (食べる, 読む, etc.) in their て-form + いる describe an action happening right now, or a habitual/occupational activity."
      ],
      "ex": [
        "ソラさんは今勉強しています。 (Sora is studying right now.)",
        "私は英語を教えています。 (I teach English.)"
      ]
    },
    {
      "form": "～ている（結果の状態）",
      "tag": "Resulting state after a change verb",
      "def": [
        "Change verbs (結婚する, 座る, 太る, etc.) + ている describe the resulting state after a change, not the change happening in progress."
      ],
      "ex": [
        "山下先生は結婚しています。 (Professor Yamashita is married.)",
        "ゆいさんは窓の近くに座っています。 (Yui is seated near the window.)"
      ]
    },
    {
      "form": "Aさんは [体の部分]が [形容詞]です",
      "tag": "Describing physical features",
      "def": [
        "To describe a person's physical features, use Aさんは[body part]が[adjective]です rather than making the body part itself the topic. Idioms like 背が高い (tall) and 頭がいい (smart) follow the same pattern."
      ],
      "ex": [
        "トムさんは髪が長いです。 (Tom has long hair.)"
      ]
    },
    {
      "form": "形容詞・名詞のて形",
      "tag": "くて／で joining descriptive clauses",
      "def": [
        "い-adjectives form a te-form by changing い to くて; な-adjectives and noun+です sequences add で. This joins two descriptive clauses the way て does for verbs."
      ],
      "ex": [
        "あの店の食べ物は安くて、おいしいです。 (The food at that restaurant is inexpensive and delicious.)",
        "山下先生は日本人で、五十歳ぐらいです。 (Professor Yamashita is Japanese and about fifty years old.)"
      ],
      "table": {
        "head": [
          "Type",
          "Te-form"
        ],
        "rows": [
          [
            "い-adjective",
            "い→くて"
          ],
          [
            "な-adjective／Noun＋です",
            "＋で"
          ]
        ]
      }
    },
    {
      "form": "動詞の意向形＋に行く · Verb Stem + に行く",
      "tag": "\"go/come/return in order to ~\"",
      "def": [
        "To describe moving somewhere in order to do something, attach に行く／来る／帰る to a verb's stem (the ます-form minus ます)."
      ],
      "ex": [
        "デパートにかばんを買いに行きました。 (I went to a department store to buy a bag.)",
        "メアリーさんは日本に日本語を勉強しに来ました。 (Mary came to Japan to study Japanese.)"
      ]
    },
    {
      "form": "人の数え方 · Counting People",
      "tag": "人（にん）, with irregular 一人／二人",
      "def": [
        "人 is the counter for people, but \"one person\" and \"two people\" are irregular: 一人 and 二人."
      ],
      "ex": [
        "私のクラスにインドネシア人の学生が一人います。 (There is one Indonesian student in my class.)"
      ]
    }
  ]
}

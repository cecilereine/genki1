  "grammar": [
    {
      "form": "形容詞（現在形） · Adjectives — Present Tense",
      "tag": "い-adjectives vs. な-adjectives",
      "def": [
        "い-adjectives: add です for affirmative; drop the final い and add くない(です) for negative. な-adjectives conjugate like nouns: です／じゃないです. いい (good) is irregular — its negative is よくない, not いくない. Degree adverbs like とても (very) and ちょっと (a little) go before the adjective."
      ],
      "ex": [
        "この部屋はちょっと暑いです。 (This room is a little hot.)",
        "今日、暇じゃないです。 (I'm not free today.)"
      ],
      "table": {
        "head": [
          "Type",
          "Affirmative",
          "Negative"
        ],
        "rows": [
          [
            "い-adj (忙しい)",
            "忙しいです",
            "忙しくないです"
          ],
          [
            "な-adj (静か)",
            "静かです",
            "静かじゃないです"
          ],
          [
            "いい (irregular)",
            "いいです",
            "よくないです"
          ]
        ]
      }
    },
    {
      "form": "形容詞（過去形） · Adjectives — Past Tense",
      "tag": "かった／でした conjugations",
      "def": [
        "い-adjectives: change い to かったです (affirmative) or くなかったです (negative). な-adjectives: でした／じゃなかったです. いい's past is よかったです／よくなかったです."
      ],
      "ex": [
        "沖縄の海はとてもきれいでした。 (The sea in Okinawa was very beautiful.)",
        "テストは難しくなかったです。 (The test wasn't hard.)"
      ],
      "table": {
        "head": [
          "Type",
          "Affirmative",
          "Negative"
        ],
        "rows": [
          [
            "い-adj (忙しい)",
            "忙しかったです",
            "忙しくなかったです"
          ],
          [
            "な-adj (静か)",
            "静かでした",
            "静かじゃなかったです"
          ],
          [
            "いい (irregular)",
            "よかったです",
            "よくなかったです"
          ]
        ]
      }
    },
    {
      "form": "形容詞の名詞修飾 · Adjectives — Noun Modification",
      "tag": "Placing an adjective directly before a noun",
      "def": [
        "To modify a noun, place an い-adjective's dictionary form directly before it. For な-adjectives, keep the な before the noun."
      ],
      "ex": [
        "昨日、面白い映画を見ました。 (I watched an interesting movie yesterday.)",
        "京都できれいな写真を撮りました。 (I took a beautiful picture in Kyoto.)"
      ]
    },
    {
      "form": "好き（な）／きらい（な）",
      "tag": "Likes & dislikes take が, not を",
      "def": [
        "好き and 嫌い are な-adjectives, so what's liked/disliked is marked with が, not を: XはYが好き／嫌いです。 大好き／大嫌い intensify the feeling."
      ],
      "ex": [
        "ロバートさんは日本語のクラスが好きです。 (Robert likes his Japanese class.)",
        "たけしさんはコーヒーが大好きです。 (Takeshi loves coffee.)"
      ]
    },
    {
      "form": "～ましょう／～ましょうか",
      "tag": "\"Let's...\" / \"Shall we...?\"",
      "def": [
        "Drop ます from the polite stem and add ましょう to propose doing something together, or ましょうか to ask if the other person wants to."
      ],
      "ex": [
        "一緒に図書館で勉強しましょう。 (Let's study at the library together.)",
        "あそこでコーヒーを飲みましょうか。 (Shall we drink coffee over there?)"
      ]
    },
    {
      "form": "数え方 · Counting",
      "tag": "Counters follow the noun, not precede it",
      "def": [
        "Different types of items take different counter words, and the number+counter usually comes after the noun it counts, not before it."
      ],
      "ex": [
        "リーさんはTシャツを三枚買いました。 (Lee bought three T-shirts.)"
      ]
    }
  ]
}

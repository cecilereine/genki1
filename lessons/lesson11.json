  "grammar": [
    {
      "form": "～たい · Want to do",
      "tag": "verb stem + たい",
      "def": [
        "Attach たい to the verb stem to express your own wish or ask about another person’s wish. It conjugates like an い-adjective; with a transitive verb, the object may take を or が. To report another person’s wish, use a quotation or ～たがっています."
      ],
      "ex": [
        "日本[にほん]に行[い]きたいです。 (I want to go to Japan.)",
        "映画[えいが]を見[み]たくないです。 (I do not want to see a movie.)"
      ]
    },
    {
      "form": "～たり～たりする · Examples of activities",
      "tag": "short past + り",
      "def": [
        "Attach り to the short past form of verbs and finish with する to list examples of activities without implying an exhaustive list or a fixed order. Conjugate する for tense."
      ],
      "ex": [
        "週末[しゅうまつ]は本[ほん]を読[よ]んだり、映画[えいが]を見[み]たりしました。 (I read and watched movies, among other things.)"
      ]
    },
    {
      "form": "～ことがある · Experience",
      "tag": "short past + ことがある",
      "def": [
        "Use the affirmative short past form plus ことがある to say that you have had an experience. ことがありません says you have never had it."
      ],
      "ex": [
        "日本[にほん]に行[い]ったことがあります。 (I have been to Japan.)",
        "馬[うま]に乗[の]ったことがありません。 (I have never ridden a horse.)"
      ]
    },
    {
      "form": "Noun A や Noun B · Examples",
      "tag": "A や B",
      "def": [
        "Use や to list examples of nouns, suggesting there may be others."
      ],
      "ex": [
        "京都[きょうと]や奈良[なら]に行[い]きました。 (I visited Kyoto and Nara, among other places.)"
      ]
    }
  ]
